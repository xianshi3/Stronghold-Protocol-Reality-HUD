diff --git a/test/match/reality-hud-damage.test.js b/test/match/reality-hud-damage.test.js
new file mode 100644
index 00000000..26bec0c8
--- /dev/null
+++ b/test/match/reality-hud-damage.test.js
@@ -0,0 +1,124 @@
+// test/match/reality-hud-damage.test.js — the Reality HUD damage patch's server half
+// (Stronghold-Protocol-Reality-HUD `server-patch/reality-hud-damage.patch`): every m.public player row carries
+//   hudDmg { round, dmg, total } — `dmg` is the damage of round `round` (a normal round stamps the damage its
+//   settlement credits, MatchSettle.settle; a boss round refreshes it at the ~1 Hz m.public cadence from a live
+//   client-run field's own f.bossBy share) and `total` is the match's cumulative (settled stats plus a live boss
+//   field's own share — never both, _finishFinal moves the share into stats exactly once).
+// The round stamp is what keeps a frame still in flight when the round advances out of 本回合 (the teammate sees 0
+// for the new round instead of the old round's number); a vanilla client ignores the extra field.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { makeMatch } from './harness.js';
+import { MatchViews } from '../../server/match/match/views.js';
+import { PHASE } from '../../shared/constants.js';
+
+/** _hudDmgView bound to a stub `this`: the method reads only `this.round` / `this.fields`. */
+const viewOf = (round, fields, ps) => MatchViews.prototype._hudDmgView.call({ round, fields }, ps);
+/** The player's hudDmg row out of the live m.public view. */
+const rowOf = (m, pid) => m.publicView().players.find((p) => p.playerId === pid).hudDmg;
+/** A PlayerState stub with the fields _hudDmgView reads. */
+const psStub = (o = {}) => ({ playerId: 'p_0', hudRound: 0, hudDmg: 0, stats: { dmgDealt: 0 }, ...o });
+/** A client-run field stub: only a live boss / hidden field carries a pool share the view may add. */
+const field = (bossBy, { kind = 'boss', live = true, done = false, cc = true } = {}) => ({ kind, cc, live, done, bossBy });
+
+test('hudDmg view: the round stamp zeroes an older round; a live boss field adds its share once', () => {
+  // nothing credited yet
+  assert.deepEqual(viewOf(3, [], psStub()), { round: 3, dmg: 0, total: 0 });
+  // this round credited 420: 本回合 420, 全局 = the settled cumulative
+  assert.deepEqual(viewOf(3, [], psStub({ hudRound: 3, hudDmg: 420, stats: { dmgDealt: 1000 } })), { round: 3, dmg: 420, total: 1000 });
+  // the round advanced while the frame is in flight: round 3's number never shows up in round 4
+  assert.deepEqual(viewOf(4, [], psStub({ hudRound: 3, hudDmg: 420, stats: { dmgDealt: 1000 } })), { round: 4, dmg: 0, total: 1000 });
+  // a live boss field's own share counts in both columns — the finished field is in stats already (never both),
+  // a normal field carries no pool share, and a server-run (non-client) field has none to read
+  const fields = [
+    field({ p_0: 300 }),
+    field({ p_0: 120 }, { kind: 'hidden' }),
+    field({ p_0: 999 }, { live: false, done: true }),
+    field({ p_0: 777 }, { kind: 'normal' }),
+    field({ p_0: 555 }, { cc: false }),
+  ];
+  assert.deepEqual(viewOf(9, fields, psStub({ hudRound: 8, hudDmg: 500, stats: { dmgDealt: 1000 } })),
+    { round: 9, dmg: 420, total: 1420 });
+  // and a live share of a round already credited adds on top (a normal round's battle still running is impossible;
+  // this is the shape mid-round of a boss round that had its settlement stamped)
+  assert.deepEqual(viewOf(9, [field({ p_0: 80 })], psStub({ hudRound: 9, hudDmg: 500, stats: { dmgDealt: 1500 } })),
+    { round: 9, dmg: 580, total: 1580 });
+  // garbage never reaches the wire (negative / missing numbers)
+  assert.deepEqual(viewOf(9, [field({ p_0: -5 })], psStub({ hudRound: 9, hudDmg: -3, stats: { dmgDealt: -1 } })),
+    { round: 9, dmg: 0, total: 0 });
+  assert.deepEqual(viewOf(9, [], { playerId: 'p_0', hudRound: 9, hudDmg: 4 }), { round: 9, dmg: 4, total: 0 });
+});
+
+test('hudDmg: a normal round stamps its settlement; the next round reads 0 until it settles', () => {
+  const h = makeMatch({
+    mode: 'coop', difficulty: 'NORMAL', humans: 2, seed: 101, fake: true, clientCombat: true, instant: false,
+    script: (b) => (b.kind === 'normal' ? { damage: { p_0: 700, p_1: 500 } } : {}),
+  });
+  const m = h.m;
+  const pub = [];
+  h.onBroadcast.push((msg) => { if (msg.t === 'm.public') pub.push(msg); });
+  h.autoHumans();
+  h.start();
+  h.toPrep(1);
+  assert.deepEqual(rowOf(m, 'p_0'), { round: 1, dmg: 0, total: 0 }, 'PREP R1: nothing credited yet');
+  h.toPrep(2); // round 1 played and settled
+  const settle1 = pub.filter((x) => x.phase === PHASE.SETTLE && x.round === 1).pop();
+  assert.ok(settle1, 'a m.public frame went out during R1 SETTLE');
+  assert.deepEqual(settle1.players.find((p) => p.playerId === 'p_0').hudDmg, { round: 1, dmg: 700, total: 700 });
+  assert.deepEqual(settle1.players.find((p) => p.playerId === 'p_1').hudDmg, { round: 1, dmg: 500, total: 500 });
+  // ROUND_START R2 advanced the round: the same player now reads 0 for 本回合, the cumulative stands
+  assert.deepEqual(rowOf(m, 'p_0'), { round: 2, dmg: 0, total: 700 });
+  h.toPrep(3); // round 2 played and settled
+  const settle2 = pub.filter((x) => x.phase === PHASE.SETTLE && x.round === 2).pop();
+  assert.deepEqual(settle2.players.find((p) => p.playerId === 'p_0').hudDmg, { round: 2, dmg: 700, total: 1400 });
+  assert.deepEqual(rowOf(m, 'p_0'), { round: 3, dmg: 0, total: 1400 });
+  // the stored stamp agrees (what _hudDmgView reads after a reconnect / watch)
+  assert.equal(h.ps('p_0').hudRound, 2);
+  assert.equal(h.ps('p_0').hudDmg, 700);
+  assert.equal(h.ps('p_0').stats.dmgDealt, 1400);
+  h.invariants();
+  m.dispose();
+});
+
+test('hudDmg: a live boss round shares the pool damage, then settles it once (no double count)', () => {
+  const h = makeMatch({
+    mode: 'coop', difficulty: 'NORMAL', humans: 2, seed: 102, fake: true, clientCombat: true, instant: false,
+    script: (b) => (b.kind === 'boss' || b.kind === 'hidden'
+      ? { bossDps: 50, damage: { p_0: 800, p_1: 600 } }
+      : { damage: { p_0: 300, p_1: 200 } }),
+  });
+  const m = h.m;
+  const pub = [];
+  h.onBroadcast.push((msg) => { if (msg.t === 'm.public') pub.push(msg); });
+  h.autoHumans();
+  h.start();
+  h.drive(() => m.phase === PHASE.FINAL_ASSAULT);
+  assert.equal(m.round, m.gd.bossRound);
+  const ps = h.ps('p_0');
+  const ps1 = h.ps('p_1');
+  const preBoss = ps.stats.dmgDealt; // every normal round before the boss settled
+  const preBoss1 = ps1.stats.dmgDealt;
+  assert.ok(preBoss > 0 && preBoss1 > 0);
+  assert.equal(rowOf(m, 'p_0').dmg, 0, 'the boss round starts at 0');
+  assert.equal(rowOf(m, 'p_0').total, Math.round(preBoss), 'the settled cumulative carries over');
+  // a couple of seconds in, the authority's reported pool damage is credited per player and shows up live
+  h.sched.advance(2000);
+  const f = m.fields.find((x) => x.kind === 'boss');
+  const live = f.bossBy['p_0'] || 0;
+  assert.ok(live > 0, `the client's pool damage reaches f.bossBy (${live})`);
+  const want = { round: m.gd.bossRound, dmg: Math.round(live), total: Math.round(preBoss + live) };
+  assert.deepEqual(rowOf(m, 'p_0'), want);
+  m.flush(true);
+  const mid = pub[pub.length - 1];
+  assert.equal(mid.phase, PHASE.FINAL_ASSAULT);
+  assert.deepEqual(mid.players.find((p) => p.playerId === 'p_0').hudDmg, want, 'the live row is on the wire');
+  // the fight ends: the battle's own result is the truth — stamped as this round, added to the cumulative once
+  h.drive(() => ps.hudRound === m.gd.bossRound);
+  assert.equal(ps.hudDmg, 800);
+  assert.equal(ps.stats.dmgDealt, preBoss + 800);
+  assert.deepEqual(rowOf(m, 'p_0'), { round: m.gd.bossRound, dmg: 800, total: preBoss + 800 });
+  assert.equal(ps1.hudDmg, 600);
+  assert.equal(ps1.stats.dmgDealt, preBoss1 + 600);
+  h.runToEnd();
+  m.dispose();
+});

diff --git a/test/sim/damage-attribution.test.js b/test/sim/damage-attribution.test.js
new file mode 100644
index 00000000..60f7910f
--- /dev/null
+++ b/test/sim/damage-attribution.test.js
@@ -0,0 +1,91 @@
+// The 'dmg' tuple's attribution slot (Reality HUD damage patch, 1.7.1): a hit credited to a unit appends that
+// unit's id at index 5 — the mark slot stays at index 4, `null` when the hit is not a red number — so
+// per-operator / per-player damage accounting can pin every hit to its attacker instead of guessing by `atk`
+// order. The guess is what this replaces: a melee hit landing between a ranged shot and its projectile popped
+// the ranged operator's pending attack, and the projectile later popped the melee one — the two operators'
+// damage swapped (and with two players' units on one field, so did the players' rows).
+// A sourceless hit keeps the four-element shape (nothing to attribute); index 4 ('r', the official red number)
+// keeps its meaning and its tests (official-damage-numbers.test.js).
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { makeBattle, chessRec, enemyRec } from '../helpers/battleHarness.js';
+
+function field() {
+  const h = makeBattle({
+    defs: {
+      chess: {
+        t_a: chessRec({ id: 't_a', stats: { atk: 1000 } }),
+        t_b: chessRec({ id: 't_b', stats: { atk: 1000 } }),
+      },
+      enemies: { enemy_dummy: enemyRec({ key: 'enemy_dummy', hp: 100000, def: 400, res: 0, speed: 0 }) },
+    },
+    units: [{ chessId: 't_a', row: 9, col: 3 }, { chessId: 't_b', row: 9, col: 5 }],
+    enemies: [{ key: 'enemy_dummy', pos: [11, 8] }],
+    content: 'none',
+  });
+  h.step();
+  return h;
+}
+
+function added(h, kind, fn) {
+  const before = h.eventsOf(kind).length;
+  const result = fn();
+  return { result, ev: h.eventsOf(kind).slice(before) };
+}
+
+test('a credited hit carries its attacker id at index 5 (mark slot null unless red)', () => {
+  const h = field();
+  const e = h.enemy('enemy_dummy');
+  const op = h.unit('t_a');
+
+  const plain = added(h, 'dmg', () => h.b.dealDamage(op, e, { amount: 100, type: 'true' }));
+  assert.equal(plain.result, 100);
+  assert.deepEqual(plain.ev[0], ['dmg', e.id, 100, 'true', null, op.id], 'mark slot stays at 4 (null), the attacker id follows');
+
+  h.b.addBuff(op, { key: 'dealt', mods: { dmgDealtMul: 2 } });
+  const red = added(h, 'dmg', () => h.b.dealDamage(op, e, { amount: 100, type: 'true' }));
+  assert.equal(red.result, 200);
+  assert.deepEqual(red.ev[0], ['dmg', e.id, 200, 'true', 'r', op.id], 'a red hit keeps the mark at 4 and the id at 5');
+  h.b.removeBuff(op, op.findBuff('dealt'));
+
+  // 无来源 (`sourceless`): the hooks see no source but the match still credits this unit — the tuple tags it,
+  // exactly like applyHpLoss's own `pp.damageDealt` accounting.
+  const credited = added(h, 'dmg', () => h.b.dealDamage(op, e, { amount: 100, type: 'true', sourceless: true }));
+  assert.equal(credited.result, 100);
+  assert.deepEqual(credited.ev[0], ['dmg', e.id, 100, 'true', null, op.id], 'sourceless hooks do not drop the credited source from the tuple');
+
+  const none = added(h, 'dmg', () => h.b.dealDamage(null, e, { amount: 100, type: 'true' }));
+  assert.deepEqual(none.ev[0], ['dmg', e.id, 100, 'true'], 'a truly sourceless hit keeps the four-element shape');
+});
+
+test('two attackers on one enemy keep their own ids, whatever the order their hits land in', () => {
+  const h = field();
+  const e = h.enemy('enemy_dummy');
+  const a = h.unit('t_a');
+  const b = h.unit('t_b');
+
+  // The regression order: A attacks (its rarer projectile still in flight), B's melee hit lands first, then A's.
+  // Under attack-order guessing B's hit popped A's pending attack and A's hit popped B's — the two swapped.
+  const bHit = added(h, 'dmg', () => h.b.dealDamage(b, e, { amount: 300, type: 'phys', defIgnorePct: 1 }));
+  const aHit = added(h, 'dmg', () => h.b.dealDamage(a, e, { amount: 100, type: 'arts' }));
+  assert.equal(bHit.ev[0][5], b.id);
+  assert.equal(aHit.ev[0][5], a.id);
+  // the penetration makes B's hit a red number: the mark and the source id coexist ('r' at 4, id at 5)
+  assert.deepEqual(bHit.ev[0], ['dmg', e.id, 300, 'phys', 'r', b.id]);
+  assert.deepEqual(aHit.ev[0], ['dmg', e.id, 100, 'arts', null, a.id]);
+});
+
+test('element gauge fills tag their source the same way; sourceless fills stay four elements', () => {
+  const h = field();
+  const e = h.enemy('enemy_dummy');
+  const op = h.unit('t_a');
+
+  const bare = added(h, 'dmg', () => h.b.dealDamage(null, e, { amount: 80, type: 'element', element: 'burn' }));
+  assert.equal(bare.ev.length, 1);
+  assert.equal(bare.ev[0].length, 4, 'a sourceless gauge fill is not attributable');
+  assert.equal(bare.ev[0][3], 'burn');
+
+  const filled = added(h, 'dmg', () => h.b.dealDamage(op, e, { amount: 80, type: 'element', element: 'burn' }));
+  assert.equal(filled.ev.length, 1);
+  assert.deepEqual(filled.ev[0], ['dmg', e.id, 80, 'burn', null, op.id], 'the gauge fill names the unit that fed it');
+});

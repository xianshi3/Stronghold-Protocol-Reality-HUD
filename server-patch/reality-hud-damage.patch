+// test/lobby-hud-relay.test.js — the HUD's live-damage relay `m.hudDmg` through the real server routing:
+// net.js → lobby.onMessage → the running match. Without the lobby route the server answered BAD_MSG
+// 'unhandled type m.hudDmg' (the 1.8.0 day-one bug). The message must reach routeGame instead — before a
+// match starts that reads WRONG_PHASE 'no running match', never the lobby's 'unhandled type'.
+// Run: node --test test/lobby-hud-relay.test.js
+import { describe, test, before, after, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { startServer } from '../server/index.js';
+import { StubMatch } from '../server/match/StubMatch.js';
+import { TestClient } from './helpers/wsClient.js';
+
+function clientPool(getUrl) {
+  const open = new Set();
+  return {
+    async connect() { const c = await TestClient.connect(getUrl()); open.add(c); return c; },
+    async player(name, token) {
+      const c = await this.connect();
+      const w = await c.hello(name, token);
+      c.id = w.playerId;
+      c.token = w.token;
+      return c;
+    },
+    async closeAll() {
+      await Promise.all([...open].map((c) => c.terminate().catch(() => {})));
+      open.clear();
+    },
+  };
+}
+const quietLog = () => {
+  const errors = [];
+  return { errors, log: { info() {}, warn() {}, debug() {}, error: (...a) => errors.push(a.map(String).join(' ')) } };
+};
+const ok = async (c, msg) => { const r = await c.request(msg); assert.equal(r.t, 'ok', `${msg.t}: ${JSON.stringify(r)}`); return r; };
+
+describe('m.hudDmg routing (lobby)', () => {
+  let srv;
+  let pool;
+  const cap = quietLog();
+  before(async () => {
+    srv = await startServer({ port: 0, host: '127.0.0.1', log: cap.log, MatchClass: StubMatch, lobbyGraceMs: 60_000 });
+    pool = clientPool(() => `ws://127.0.0.1:${srv.port}/ws`);
+  });
+  after(async () => {
+    await pool.closeAll();
+    await srv.close();
+  });
+  afterEach(() => {
+    assert.equal(cap.errors.length, 0, `server logged errors: ${cap.errors.join(' | ')}`);
+    cap.errors.length = 0;
+  });
+
+  test('m.hudDmg routes to the match, not the lobby\'s unhandled-type bucket', async () => {
+    const c = await pool.player('relay');
+    await ok(c, { t: 'room.create', mode: 'coop', difficulty: 'NORMAL' });
+    await c.waitFor('room.state', (s) => s.hostId === c.id);
+    // fire-and-forget like the HUD: no rid
+    c.send({ t: 'm.hudDmg', dmg: 123 });
+    const reply = await c.waitFor('error');
+    assert.equal(reply.code, 'WRONG_PHASE', JSON.stringify(reply));
+    assert.equal(reply.detail, 'no running match', JSON.stringify(reply));
+    await c.close();
+  });
+});
diff --git a/test/lobby-invite.test.js b/test/lobby-invite.test.js
new file mode 100644
index 00000000..634031c9
--- /dev/null
+++ b/test/lobby-invite.test.js
@@ -0,0 +1,198 @@
+// test/lobby-invite.test.js — room.invite / room.invited and GET /api/players (the Reality HUD
+// overlay's in-game invite: a player in a room asks the server to forward its room code to another
+// online session, S2C room.invited; the roster behind the HUD's invite list). The room code only
+// ever reaches the invited session — never the roster — and the push is rate-limited by the
+// per-connection heavy bucket (server/net.js HEAVY_TYPES).
+// Run: node --test test/lobby-invite.test.js
+import { describe, test, before, after, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { startServer } from '../server/index.js';
+import { StubMatch } from '../server/match/StubMatch.js';
+import { TestClient } from './helpers/wsClient.js';
+import { ERR } from '../shared/constants.js';
+import { C2S, S2C, validateC2S } from '../shared/protocol.js';
+
+function clientPool(getUrl) {
+  const open = new Set();
+  return {
+    async connect() { const c = await TestClient.connect(getUrl()); open.add(c); return c; },
+    async player(name, token) {
+      const c = await this.connect();
+      const w = await c.hello(name, token);
+      c.id = w.playerId;
+      c.token = w.token;
+      return c;
+    },
+    async closeAll() {
+      await Promise.all([...open].map((c) => c.terminate().catch(() => {})));
+      open.clear();
+    },
+  };
+}
+const quietLog = () => {
+  const errors = [];
+  return { errors, log: { info() {}, warn() {}, debug() {}, error: (...a) => errors.push(a.map(String).join(' ')) } };
+};
+const ok = async (c, msg) => { const r = await c.request(msg); assert.equal(r.t, 'ok', `${msg.t}: ${JSON.stringify(r)}`); return r; };
+const err = async (c, msg, code) => { const r = await c.request(msg); assert.equal(r.t, 'error', JSON.stringify(r)); assert.equal(r.code, code, JSON.stringify(r)); return r; };
+const seatOf = (state, id) => state.seats.find((s) => s && s.playerId === id) || null;
+const fetchPlayers = async (url) => {
+  const res = await fetch(`${url}/api/players`, { cache: 'no-store' });
+  assert.equal(res.status, 200);
+  return res.json();
+};
+async function createRoom(c) {
+  await ok(c, { t: 'room.create', mode: 'coop', difficulty: 'NORMAL' });
+  return c.waitFor('room.state', (s) => s.hostId === c.id);
+}
+
+describe('room.invite / room.invited (lobby)', () => {
+  let srv;
+  let pool;
+  const cap = quietLog();
+  before(async () => {
+    srv = await startServer({ port: 0, host: '127.0.0.1', log: cap.log, MatchClass: StubMatch, lobbyGraceMs: 60_000 });
+    pool = clientPool(() => `ws://127.0.0.1:${srv.port}/ws`);
+  });
+  afterEach(async () => { await pool.closeAll(); });
+  after(async () => {
+    await srv?.close();
+    assert.deepEqual(cap.errors, [], 'no server errors logged');
+  });
+
+  test('protocol: room.invite {playerId} is a C2S request, room.invited an S2C push', () => {
+    assert.ok(C2S['room.invite'], 'the C2S map knows room.invite');
+    assert.equal(validateC2S({ t: 'room.invite', playerId: 'p_0123456789' }), null);
+    assert.notEqual(validateC2S({ t: 'room.invite' }), null, 'the playerId is required');
+    assert.notEqual(validateC2S({ t: 'room.invite', playerId: 42 }), null, 'an id is a string');
+    assert.notEqual(validateC2S({ t: 'room.invite', playerId: '' }), null, 'never empty');
+    assert.ok(S2C.includes('room.invited'), 'the S2C list documents the push');
+  });
+
+  test('a room member invites an online player: room.invited {from, name, code}, which joins with the code', async () => {
+    const host = await pool.player('Host');
+    const st = await createRoom(host);
+    const guest = await pool.player('Guest');
+    await ok(host, { t: 'room.invite', playerId: guest.id });
+    const inv = await guest.waitFor('room.invited');
+    assert.equal(inv.from, host.id, 'named by the inviter');
+    assert.equal(inv.name, 'Host');
+    assert.equal(inv.code, st.code, 'the room code only reaches the invited session');
+    assert.equal(inv.rid, undefined, 'a push, not a reply');
+    // the invited side joins exactly like the ?room= deep link does
+    await ok(guest, { t: 'room.join', code: inv.code });
+    const state = await guest.waitFor('room.state', (s) => !!seatOf(s, guest.id));
+    assert.equal(state.code, st.code);
+    // and inviting somebody already here is refused
+    await err(host, { t: 'room.invite', playerId: guest.id }, ERR.BAD_TARGET);
+  });
+
+  test('refusals: outside a room, yourself, an unknown or offline target, a spectator', async () => {
+    const host = await pool.player('Host');
+    const st = await createRoom(host);
+    const stranger = await pool.player('Stranger');
+    await err(stranger, { t: 'room.invite', playerId: host.id }, ERR.NOT_IN_ROOM, 'no room of its own');
+    await err(host, { t: 'room.invite', playerId: host.id }, ERR.BAD_TARGET, 'yourself');
+    await err(host, { t: 'room.invite', playerId: 'p_nosuchplayer' }, ERR.BAD_TARGET, 'unknown id');
+    const gone = await pool.player('Gone');
+    await gone.terminate();
+    // wait until the server has seen the drop — the roster drops a session the moment its socket
+    // closes, so until then a still-listed session would make this invite succeed instead
+    for (let i = 0; i < 200; i++) {
+      const b = await fetchPlayers(srv.url);
+      if (!b.players.some((p) => p.id === gone.id)) break;
+      await new Promise((r) => setTimeout(r, 25));
+    }
+    await err(host, { t: 'room.invite', playerId: gone.id }, ERR.BAD_TARGET, 'offline');
+    // a spectator seat only watches (server/lobby.js invite)
+    const spectator = await pool.player('Watcher');
+    await ok(spectator, { t: 'room.spectate', code: st.code });
+    await host.waitFor('room.state', (s) => s.spectators.some((x) => x.playerId === spectator.id));
+    await err(spectator, { t: 'room.invite', playerId: host.id }, ERR.SPECTATOR);
+    // inviting somebody into a running match would answer room.join ROOM_STARTED — the invite itself
+    // is allowed (the target's own screen decides); the heavy bucket below caps how often it can be asked
+  });
+
+  test('the per-connection heavy bucket caps invite spam: burst 6, then RATE', async () => {
+    const host = await pool.player('Host');
+    await createRoom(host);
+    const guest = await pool.player('Guest');
+    let rate = null;
+    for (let i = 0; i < 8 && !rate; i++) {
+      const r = await host.request({ t: 'room.invite', playerId: guest.id });
+      if (r.t === 'error') { assert.equal(r.code, ERR.RATE, JSON.stringify(r)); rate = i + 1; }
+      else assert.equal(r.t, 'ok', JSON.stringify(r));
+    }
+    assert.ok(rate != null && rate <= 8, 'the 7th (or sooner) invite draws RATE');
+    assert.match((await guest.waitFor('room.invited')).code, /^[A-Z0-9]+$/, 'the invites that got through arrived');
+  });
+});
+
+describe('GET /api/players (routes)', () => {
+  let srv;
+  let pool;
+  const cap = quietLog();
+  before(async () => {
+    srv = await startServer({ port: 0, host: '127.0.0.1', log: cap.log, MatchClass: StubMatch, lobbyGraceMs: 60_000 });
+    pool = clientPool(() => `ws://127.0.0.1:${srv.port}/ws`);
+  });
+  afterEach(async () => { await pool.closeAll(); });
+  after(async () => {
+    await srv?.close();
+    assert.deepEqual(cap.errors, [], 'no server errors logged');
+  });
+
+  const getPlayers = async () => {
+    const res = await fetch(`${srv.url}/api/players`, { cache: 'no-store' });
+    assert.equal(res.status, 200);
+    assert.match(res.headers.get('cache-control') || '', /no-store/, 'never cached');
+    return res.json();
+  };
+
+  test('lists connected sessions: id, name, inRoom, inMatch — never a room code or token', async () => {
+    const host = await pool.player('Host');
+    const st = await createRoom(host);
+    const guest = await pool.player('Guest');
+
+    let body = await getPlayers();
+    assert.equal(body.ok, true);
+    const byId = new Map(body.players.map((p) => [p.id, p]));
+    // the shape: name + where they are, nothing secret
+    for (const p of body.players) {
+      assert.deepEqual(Object.keys(p).sort(), ['id', 'inMatch', 'inRoom', 'name'], 'exactly these keys');
+      assert.equal(typeof p.name, 'string');
+      assert.equal(typeof p.inRoom, 'boolean');
+      assert.equal(typeof p.inMatch, 'boolean');
+      assert.equal(p.token, undefined);
+      assert.equal(p.code, undefined);
+      assert.equal(p.roomCode, undefined);
+    }
+    assert.equal(byId.get(host.id).name, 'Host');
+    assert.equal(byId.get(host.id).inRoom, true, 'the host sits in its room');
+    assert.equal(byId.get(host.id).inMatch, false, 'no match yet');
+    assert.equal(byId.get(guest.id).inRoom, false, 'the guest is still in the lobby');
+
+    // joining flips the flag for the invited side
+    await ok(guest, { t: 'room.join', code: st.code });
+    await guest.waitFor('room.state', (s) => !!seatOf(s, guest.id));
+    body = await getPlayers();
+    assert.equal(body.players.find((p) => p.id === guest.id).inRoom, true);
+
+    // a dropped session leaves the roster (it stays in the registry as a reconnect window)
+    await guest.terminate();
+    const dropped = await host.waitFor('room.state', (s) => seatOf(s, guest.id)?.connected === false);
+    body = await getPlayers();
+    assert.equal(body.players.some((p) => p.id === guest.id), false, 'only connected sessions list');
+
+    // a running match shows up as inMatch (this is what greys out the invite button in the HUD).
+    // the dropped guest's seat goes first — a not-ready human seat would block room.start
+    await ok(host, { t: 'room.kick', seat: seatOf(dropped, guest.id).seat, playerId: guest.id });
+    await ok(host, { t: 'room.start' });
+    await host.waitFor('room.state', (s) => s.inMatch === true);
+    body = await getPlayers();
+    const row = body.players.find((p) => p.id === host.id);
+    assert.equal(row.inRoom, true);
+    assert.equal(row.inMatch, true);
+  });
+});
diff --git a/test/match/reality-hud-damage.test.js b/test/match/reality-hud-damage.test.js
new file mode 100644
index 00000000..1e115bcc
--- /dev/null
+++ b/test/match/reality-hud-damage.test.js
@@ -0,0 +1,229 @@
+// test/match/reality-hud-damage.test.js — the Reality HUD damage patch's server half
+// (Stronghold-Protocol-Reality-HUD `server-patch/reality-hud-damage.patch`): every m.public player row carries
+//   hudDmg { round, dmg, total, settled } — `dmg` is the damage of round `round` (a normal round stamps the damage
+//   its settlement credits, MatchSettle.settle; a boss round refreshes it at the ~1 Hz m.public cadence from a live
+//   client-run field's own f.bossBy share), `total` is the match's cumulative (settled stats plus a live boss
+//   field's own share — never both, _finishFinal moves the share into stats exactly once) and `settled` says `dmg`
+//   is that round's complete credited damage — the flag the HUD snaps its local live estimate to (1.7.1), so every
+//   player's screen ends a round on the server's number instead of its own raw-event sum.
+// The round stamp is what keeps a frame still in flight when the round advances out of 本回合 (the teammate sees 0
+// for the new round instead of the old round's number); a vanilla client ignores the extra field.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { makeMatch } from './harness.js';
+import { MatchViews } from '../../server/match/match/views.js';
+import { validateC2S } from '../../shared/protocol.js';
+import { PHASE } from '../../shared/constants.js';
+
+/** _hudDmgView bound to a stub `this`: the method reads only `this.round` / `this.fields`. */
+const viewOf = (round, fields, ps) => MatchViews.prototype._hudDmgView.call({ round, fields }, ps);
+/** The player's hudDmg row out of the live m.public view. */
+const rowOf = (m, pid) => m.publicView().players.find((p) => p.playerId === pid).hudDmg;
+/** A PlayerState stub with the fields _hudDmgView reads. */
+const psStub = (o = {}) => ({ playerId: 'p_0', hudRound: 0, hudDmg: 0, stats: { dmgDealt: 0 }, ...o });
+/** A client-run field stub: only a live boss / hidden field carries a pool share the view may add. */
+const field = (bossBy, { kind = 'boss', live = true, done = false, cc = true } = {}) => ({ kind, cc, live, done, bossBy });
+
+test('hudDmg view: the round stamp zeroes an older round; a live boss field adds its share once', () => {
+  // nothing credited yet — no stamp for this round, so nothing is settled either
+  assert.deepEqual(viewOf(3, [], psStub()), { round: 3, dmg: 0, total: 0, settled: false });
+  // this round credited 420: 本回合 420, 全局 = the settled cumulative — complete, settled
+  assert.deepEqual(viewOf(3, [], psStub({ hudRound: 3, hudDmg: 420, stats: { dmgDealt: 1000 } })),
+    { round: 3, dmg: 420, total: 1000, settled: true });
+  // the round advanced while the frame is in flight: round 3's number never shows up in round 4
+  assert.deepEqual(viewOf(4, [], psStub({ hudRound: 3, hudDmg: 420, stats: { dmgDealt: 1000 } })),
+    { round: 4, dmg: 0, total: 1000, settled: false });
+  // a live boss field's own share counts in both columns — the finished field is in stats already (never both),
+  // a normal field carries no pool share, and a server-run (non-client) field has none to read; the round has no
+  // stamp of its own, so the number is only a partial-so-far — never settled
+  const fields = [
+    field({ p_0: 300 }),
+    field({ p_0: 120 }, { kind: 'hidden' }),
+    field({ p_0: 999 }, { live: false, done: true }),
+    field({ p_0: 777 }, { kind: 'normal' }),
+    field({ p_0: 555 }, { cc: false }),
+  ];
+  assert.deepEqual(viewOf(9, fields, psStub({ hudRound: 8, hudDmg: 500, stats: { dmgDealt: 1000 } })),
+    { round: 9, dmg: 420, total: 1420, settled: false });
+  // a live share of a round already credited adds on top (a normal round's battle still running is impossible;
+  // this is the shape mid-round of a boss round that had its settlement stamped) — the live part is still outside
+  // stats, so the row is NOT settled: the HUD may only top up, never snap down to it
+  assert.deepEqual(viewOf(9, [field({ p_0: 80 })], psStub({ hudRound: 9, hudDmg: 500, stats: { dmgDealt: 1500 } })),
+    { round: 9, dmg: 580, total: 1580, settled: false });
+  // the HUD's own relay of a client-run field (m.hudDmg, 1.8.0) counts like a boss share: partial-so-far, never settled
+  assert.deepEqual(viewOf(9, [], psStub({ hudLiveRound: 9, hudLiveDmg: 250, stats: { dmgDealt: 1000 } })),
+    { round: 9, dmg: 250, total: 1250, settled: false });
+  // a stale relay (an older round) or garbage never reaches the wire
+  assert.deepEqual(viewOf(9, [], psStub({ hudLiveRound: 8, hudLiveDmg: 250, stats: { dmgDealt: 1000 } })),
+    { round: 9, dmg: 0, total: 1000, settled: false });
+  assert.deepEqual(viewOf(9, [], psStub({ hudLiveRound: 9, hudLiveDmg: -5, stats: { dmgDealt: 1000 } })),
+    { round: 9, dmg: 0, total: 1000, settled: false });
+  // garbage never reaches the wire (negative / missing numbers)
+  assert.deepEqual(viewOf(9, [field({ p_0: -5 })], psStub({ hudRound: 9, hudDmg: -3, stats: { dmgDealt: -1 } })),
+    { round: 9, dmg: 0, total: 0, settled: true });
+  assert.deepEqual(viewOf(9, [], { playerId: 'p_0', hudRound: 9, hudDmg: 4 }), { round: 9, dmg: 4, total: 0, settled: true });
+});
+
+test('hudDmg: a normal round stamps its settlement; the next round reads 0 until it settles', () => {
+  const h = makeMatch({
+    mode: 'coop', difficulty: 'NORMAL', humans: 2, seed: 101, fake: true, clientCombat: true, instant: false,
+    script: (b) => (b.kind === 'normal' ? { damage: { p_0: 700, p_1: 500 } } : {}),
+  });
+  const m = h.m;
+  const pub = [];
+  h.onBroadcast.push((msg) => { if (msg.t === 'm.public') pub.push(msg); });
+  h.autoHumans();
+  h.start();
+  h.toPrep(1);
+  assert.deepEqual(rowOf(m, 'p_0'), { round: 1, dmg: 0, total: 0, settled: false }, 'PREP R1: nothing credited yet');
+  h.toPrep(2); // round 1 played and settled
+  const settle1 = pub.filter((x) => x.phase === PHASE.SETTLE && x.round === 1).pop();
+  assert.ok(settle1, 'a m.public frame went out during R1 SETTLE');
+  assert.deepEqual(settle1.players.find((p) => p.playerId === 'p_0').hudDmg, { round: 1, dmg: 700, total: 700, settled: true });
+  assert.deepEqual(settle1.players.find((p) => p.playerId === 'p_1').hudDmg, { round: 1, dmg: 500, total: 500, settled: true });
+  // ROUND_START R2 advanced the round: the same player now reads 0 for 本回合, the cumulative stands
+  assert.deepEqual(rowOf(m, 'p_0'), { round: 2, dmg: 0, total: 700, settled: false });
+  h.toPrep(3); // round 2 played and settled
+  const settle2 = pub.filter((x) => x.phase === PHASE.SETTLE && x.round === 2).pop();
+  assert.deepEqual(settle2.players.find((p) => p.playerId === 'p_0').hudDmg, { round: 2, dmg: 700, total: 1400, settled: true });
+  assert.deepEqual(rowOf(m, 'p_0'), { round: 3, dmg: 0, total: 1400, settled: false });
+  // the stored stamp agrees (what _hudDmgView reads after a reconnect / watch)
+  assert.equal(h.ps('p_0').hudRound, 2);
+  assert.equal(h.ps('p_0').hudDmg, 700);
+  assert.equal(h.ps('p_0').stats.dmgDealt, 1400);
+  h.invariants();
+  m.dispose();
+});
+
+test('hudDmg: a live boss round shares the pool damage, then settles it once (no double count)', () => {
+  const h = makeMatch({
+    mode: 'coop', difficulty: 'NORMAL', humans: 2, seed: 102, fake: true, clientCombat: true, instant: false,
+    script: (b) => (b.kind === 'boss' || b.kind === 'hidden'
+      ? { bossDps: 50, damage: { p_0: 800, p_1: 600 } }
+      : { damage: { p_0: 300, p_1: 200 } }),
+  });
+  const m = h.m;
+  const pub = [];
+  h.onBroadcast.push((msg) => { if (msg.t === 'm.public') pub.push(msg); });
+  h.autoHumans();
+  h.start();
+  h.drive(() => m.phase === PHASE.FINAL_ASSAULT);
+  assert.equal(m.round, m.gd.bossRound);
+  const ps = h.ps('p_0');
+  const ps1 = h.ps('p_1');
+  const preBoss = ps.stats.dmgDealt; // every normal round before the boss settled
+  const preBoss1 = ps1.stats.dmgDealt;
+  assert.ok(preBoss > 0 && preBoss1 > 0);
+  assert.equal(rowOf(m, 'p_0').dmg, 0, 'the boss round starts at 0');
+  assert.equal(rowOf(m, 'p_0').total, Math.round(preBoss), 'the settled cumulative carries over');
+  assert.equal(rowOf(m, 'p_0').settled, false, 'an empty / still-running round is not settled');
+  // a couple of seconds in, the authority's reported pool damage is credited per player and shows up live
+  h.sched.advance(2000);
+  const f = m.fields.find((x) => x.kind === 'boss');
+  const live = f.bossBy['p_0'] || 0;
+  assert.ok(live > 0, `the client's pool damage reaches f.bossBy (${live})`);
+  // a live share is a partial-so-far: the HUD tops up to it but must not snap down to it
+  const want = { round: m.gd.bossRound, dmg: Math.round(live), total: Math.round(preBoss + live), settled: false };
+  assert.deepEqual(rowOf(m, 'p_0'), want);
+  m.flush(true);
+  const mid = pub[pub.length - 1];
+  assert.equal(mid.phase, PHASE.FINAL_ASSAULT);
+  assert.deepEqual(mid.players.find((p) => p.playerId === 'p_0').hudDmg, want, 'the live row is on the wire');
+  // the fight ends: the battle's own result is the truth — stamped as this round, added to the cumulative once
+  h.drive(() => ps.hudRound === m.gd.bossRound);
+  assert.equal(ps.hudDmg, 800);
+  assert.equal(ps.stats.dmgDealt, preBoss + 800);
+  assert.deepEqual(rowOf(m, 'p_0'), { round: m.gd.bossRound, dmg: 800, total: preBoss + 800, settled: true });
+  assert.equal(ps1.hudDmg, 600);
+  assert.equal(ps1.stats.dmgDealt, preBoss1 + 600);
+  h.runToEnd();
+  m.dispose();
+});
+
+test('hudDmg: a 联防 round credits each player its own battle plus its own unite part, never the partner\'s', () => {
+  const h = makeMatch({
+    mode: 'coop', difficulty: 'NORMAL', humans: 2, seed: 103, fake: true, clientCombat: true, instant: false,
+    script: (b) => {
+      if (b.kind === 'normal') return { leaks: { p_0: 3 }, damage: { p_0: 700, p_1: 500 } };
+      if (b.kind === 'unite') return { damage: { p_1: 400 } };
+      return {};
+    },
+  });
+  const m = h.m;
+  const pub = [];
+  h.onBroadcast.push((msg) => { if (msg.t === 'm.public') pub.push(msg); });
+  h.autoHumans();
+  h.start();
+  h.toPrep(1);
+  h.drive(() => m.phase === PHASE.UNITE);
+  assert.deepEqual(m.unitePlan.leakers.map((p) => p.playerId), ['p_0']);
+  assert.deepEqual(m.unitePlan.helpers.map((p) => p.playerId), ['p_1']);
+  const u = m.fields.find((f) => f.fieldId === 'u');
+  assert.ok(u, 'the unite field ran');
+  assert.deepEqual(u.players, ['p_1']);
+  assert.equal(u.authority, 'p_1');
+  // mid-unite nobody is settled: the leaker's own battle finished but the round stamps nothing until it settles
+  assert.deepEqual(rowOf(m, 'p_0'), { round: 1, dmg: 0, total: 0, settled: false });
+  h.drive(() => m.phase === PHASE.SETTLE);
+  const ps0 = h.ps('p_0');
+  const ps1 = h.ps('p_1');
+  // the leaker: its own battle only (it is not in the unite battle); the helper: own battle + its own unite part
+  assert.equal(ps0.stats.dmgDealt, 700);
+  assert.equal(ps1.stats.dmgDealt, 900);
+  const settle1 = pub.filter((x) => x.phase === PHASE.SETTLE && x.round === 1).pop();
+  assert.ok(settle1, 'a m.public frame went out during R1 SETTLE');
+  assert.deepEqual(settle1.players.find((p) => p.playerId === 'p_0').hudDmg, { round: 1, dmg: 700, total: 700, settled: true });
+  assert.deepEqual(settle1.players.find((p) => p.playerId === 'p_1').hudDmg, { round: 1, dmg: 900, total: 900, settled: true });
+  // the stored stamps agree, each on its own row
+  assert.equal(ps0.hudDmg, 700);
+  assert.equal(ps1.hudDmg, 900);
+  m.dispose();
+});
+
+test('hudDmg relay: a HUD reports its live damage of a client-run field (m.hudDmg) until the round settles', () => {
+  const h = makeMatch({
+    mode: 'coop', difficulty: 'NORMAL', humans: 2, seed: 104, fake: true, clientCombat: true, instant: false,
+    script: (b) => (b.kind === 'normal' ? { damage: { p_0: 700, p_1: 500 } } : {}),
+  });
+  const m = h.m;
+  h.autoHumans();
+  h.start();
+  h.toPrep(1);
+  h.drive(() => m.phase === PHASE.COMBAT);
+  assert.equal(m.publicView().hudRelay, true, 'm.public advertises the relay');
+  const ps = h.ps('p_0');
+  // the HUD reports its own live damage: it shows up in the row for everyone, live, not settled
+  assert.deepEqual(m.handle('p_0', { t: 'm.hudDmg', dmg: 1234 }), { ok: true });
+  assert.deepEqual(rowOf(m, 'p_0'), { round: 1, dmg: 1234, total: 1234, settled: false });
+  // rate limit: a second report inside the window is ignored; garbage is rejected and changes nothing
+  assert.deepEqual(m.handle('p_0', { t: 'm.hudDmg', dmg: 9999 }), { ok: true });
+  assert.equal(rowOf(m, 'p_0').dmg, 1234, 'rate-limited report ignored');
+  assert.equal(m.handle('p_0', { t: 'm.hudDmg', dmg: -5 }).error, 'BAD_MSG');
+  assert.equal(rowOf(m, 'p_0').dmg, 1234, 'garbage rejected');
+  // the round settles: the settle stamp replaces the live relay exactly once, and the relay is cleared
+  h.drive(() => ps.hudRound === 1);
+  assert.equal(ps.hudLiveDmg, 0, 'the settle clears the relay');
+  assert.deepEqual(rowOf(m, 'p_0'), { round: 1, dmg: 700, total: 700, settled: true });
+  m.dispose();
+});
+
+test('hudDmg relay: a server-run match ignores m.hudDmg (the server already sees the damage)', () => {
+  const h = makeMatch({
+    mode: 'coop', difficulty: 'NORMAL', humans: 1, bots: 1, seed: 105, fake: true, clientCombat: false, instant: false,
+  });
+  const m = h.m;
+  h.autoHumans();
+  h.start();
+  h.toPrep(1);
+  h.drive(() => m.phase === PHASE.COMBAT);
+  assert.equal(m.handle('p_0', { t: 'm.hudDmg', dmg: 500 }).ok, true);
+  assert.equal(rowOf(m, 'p_0').dmg, 0, 'no relay in server-run mode');
+  m.dispose();
+});
+
+test('hudDmg relay: the protocol accepts m.hudDmg {dmg} (the client-side send whitelist)', () => {
+  assert.equal(validateC2S({ t: 'm.hudDmg', dmg: 123 }), null);
+  assert.equal(validateC2S({ t: 'm.hudDmg', dmg: 123.5 }), null);
+  assert.equal(typeof validateC2S({ t: 'm.hudDmg' }), 'string', 'the dmg is required');
+  assert.equal(typeof validateC2S({ t: 'm.hudDmg', dmg: -1 }), 'string', 'negative rejected');
+});
